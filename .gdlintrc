# GDScript lint rules for RAMA.
#
# Deltas from gdlint's defaults, and why. The world generator, the procedural mesh
# builders and the enemy state machine are legitimately long and legitimately
# arithmetic-heavy; splitting them to satisfy a 1000-line or 6-return limit would
# fragment coherent algorithms rather than clarify them. The naming and correctness
# rules are all left ON, because those catch real mistakes.
#
#   max-file-lines 1000 -> 2550      a ratchet, not a target: set just above the largest script that
#     is still unsplit (interactables.gd, 2545 lines on 2026-11-13). It was 2600. Lower it when
#     that file is split; ROADMAP.md lists every script over 500 lines as known debt.
#   max-line-length 100 -> 120
#   max-public-methods 20 -> 70      WorldMap is deliberately a wide query surface
#   max-returns / class-definitions-order / elif-return  disabled as style-only
#   function-variable-name  also allows short (<=4 char) mixed-case locals, so the
#     geometry code can call a radius R and a chamfer distance D1 the way the maths
#     does. Renaming those to radius_value makes the formulae harder to read, not easier.
#   max-line-length 120 -> 140       villager dialogue is prose; wrapping mid-sentence
#     to satisfy a column limit hurts the thing being edited.
#   signal-name  allows a leading underscore for signals private to a UI widget.
class-definitions-order:
- tools
- classnames
- extends
- docstrings
- signals
- enums
- consts
- staticvars
- exports
- pubvars
- prvvars
- onreadypubvars
- onreadyprvvars
- others
class-load-variable-name: (([A-Z][a-z0-9]*)+|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
class-name: ([A-Z][a-z0-9]*)+
class-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
comparison-with-itself: null
constant-name: _?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*
disable:
- no-elif-return
- no-else-return
- duplicated-load
- max-returns
- class-definitions-order
duplicated-load: null
enum-element-name: '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
enum-name: ([A-Z][a-z0-9]*)+
excluded_directories: !!set
  .git: null
expression-not-assigned: null
function-argument-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
function-arguments-number: 14
function-name: (_on_([A-Z][a-z0-9]*)+(_[a-z0-9]+)*|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
function-preload-variable-name: ([A-Z][a-z0-9]*)+
function-variable-name: (_?[a-z][a-z0-9]*(_[a-z0-9]+)*|[A-Za-z][A-Za-z0-9]{0,3})
load-constant-name: (([A-Z][a-z0-9]*)+|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)
loop-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
max-file-lines: 2550
max-line-length: 140
max-public-methods: 70
max-returns: 14
mixed-tabs-and-spaces: null
no-elif-return: null
no-else-return: null
signal-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
sub-class-name: _?([A-Z][a-z0-9]*)+
tab-characters: 1
trailing-whitespace: null
unnecessary-pass: null
unused-argument: null
