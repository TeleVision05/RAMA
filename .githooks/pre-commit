#!/bin/bash
# RAMA pre-commit gate.
#
# Two checks on staged GDScript, both cheap enough to run every commit:
#   1. gdlint against .gdlintrc — style and naming.
#   2. Godot's own parser — the important half. A GDScript parse error does NOT stop
#      the game booting; the script simply fails to load and the node it backs silently
#      never appears. That is how the wildlife system went missing for an hour, and how
#      gdformat's corruption of one file in 130 was caught.
#
# Do NOT bypass with --no-verify. If a rule is wrong for this repo, change .gdlintrc
# and record why in its header.
#
# Portability: macOS ships bash 3.2, which has no `mapfile`. Keep this POSIX-ish.
set -u
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
GODOT="$HOME/tools/Godot.app/Contents/MacOS/Godot"

STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.gd$' || true)"
if [ -z "$STAGED" ]; then
  exit 0
fi

COUNT="$(printf '%s\n' "$STAGED" | wc -l | tr -d ' ')"
fail=0

if command -v gdlint >/dev/null 2>&1; then
  echo "pre-commit: gdlint on $COUNT file(s)"
  # shellcheck disable=SC2086
  if ! printf '%s\n' "$STAGED" | xargs gdlint; then
    fail=1
  fi
else
  echo "pre-commit: gdlint not installed (pip3 install 'gdtoolkit==4.*') — skipping" >&2
fi

if [ -x "$GODOT" ]; then
  # One Godot process per file costs ~1.5 s each. Past a handful of files it is far
  # cheaper to run the whole-project parse scene once, which loads every script.
  if [ "$COUNT" -gt 8 ]; then
    echo "pre-commit: Godot parse check (whole project, $COUNT files staged)"
    "$GODOT" --headless --path . --import >/dev/null 2>&1
    out="$("$GODOT" --path . res://scenes/parse_test.tscn 2>&1)"
    if ! printf '%s' "$out" | grep -q "^RESULT: PASS"; then
      echo "  PARSE FAILURES:"
      printf '%s\n' "$out" | grep -E "^  !|Parse Error" | head -10
      fail=1
    fi
  else
    echo "pre-commit: Godot parse check on $COUNT file(s)"
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      out="$("$GODOT" --headless --path . --check-only --script "$f" 2>&1)"
      if printf '%s' "$out" | grep -q "Parse Error"; then
        echo "  PARSE ERROR in $f"
        printf '%s\n' "$out" | grep -A1 "Parse Error" | head -4
        fail=1
      fi
    done <<EOF
$STAGED
EOF
  fi
else
  echo "pre-commit: Godot not found at $GODOT — skipping parse check" >&2
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "pre-commit FAILED. Fix the above, then commit again."
  exit 1
fi
echo "pre-commit: OK"
exit 0
