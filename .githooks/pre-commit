#!/bin/bash
# RAMA pre-commit gate.
#
# Two checks, both cheap enough to run every commit:
#   1. gdlint against .gdlintrc on staged GDScript — style and naming.
#   2. The fast suites of the test gate (tools/run_tests.sh --fast): every script
#      parses and loads, every input binding works, every asset and shader loads,
#      the audio beds play. A GDScript parse error does NOT stop the game booting;
#      the script simply fails to load and the node it backs silently never appears.
#      That is how the wildlife system went missing for an hour.
#
# The gate runs quietly (headless: no window, no focus, no sound), so committing
# never takes over the screen. Run the full gate with tools/run_tests.sh.
#
# Do NOT bypass with --no-verify. If a rule is wrong for this repo, change .gdlintrc
# and record why in its header.
#
# Portability: macOS ships bash 3.2, which has no `mapfile`. Keep this POSIX-ish.
set -u
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

STAGED_GD="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.gd$' || true)"
STAGED_GODOT="$(git diff --cached --name-only --diff-filter=ACMD | grep -E '\.(gd|tscn|tres|gdshader)$|^project\.godot$' || true)"
if [ -z "$STAGED_GODOT" ]; then
  exit 0
fi

fail=0

if [ -n "$STAGED_GD" ]; then
  COUNT="$(printf '%s\n' "$STAGED_GD" | wc -l | tr -d ' ')"
  if command -v gdlint >/dev/null 2>&1; then
    echo "pre-commit: gdlint on $COUNT file(s)"
    # shellcheck disable=SC2086
    if ! printf '%s\n' "$STAGED_GD" | xargs gdlint; then
      fail=1
    fi
  else
    echo "pre-commit: gdlint is not installed, so GDScript style cannot be checked and the commit is stopped." >&2
    echo "  Install it with:  pip3 install 'gdtoolkit==4.*'   (then check:  gdlint --version)" >&2
    fail=1
  fi
fi

echo "pre-commit: fast test suites (tools/run_tests.sh --fast)"
if ! tools/run_tests.sh --fast; then
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "pre-commit FAILED. Fix the above, then commit again."
  exit 1
fi
echo "pre-commit: OK"
exit 0
